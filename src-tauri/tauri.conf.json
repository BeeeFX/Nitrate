{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nitrate",
  "version": "0.4.0",
  "identifier": "app.nitrate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nitrate",
        "width": 440,
        "height": 660,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "dragDropEnabled": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": []
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nitrate"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/BeeeFX/Nitrate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFRkZFQUQ5QTA0Q0NEMEIKUldRTHpVeWcyZXIvM3NhRnJreE8rUFd1N1NtcmFzNGR1anNYbVQyMDRYdzRNR2lPa3FndW11L3cK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Compress video to fit Discord's upload limits",
    "longDescription": "Nitrate compresses any video to a target file size — Discord's 10MB free limit, Nitro tiers, or any size you pick. Drag, drop, done.",
    "copyright": "MIT licensed",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
