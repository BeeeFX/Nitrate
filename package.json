{
  "name": "nitrate",
  "version": "0.8.9",
  "description": "Drag, drop, done. Compress any video to fit Discord's upload limits.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "bump": "node scripts/bump-version.mjs",
    "extension": "node scripts/build-extension.mjs",
    "extension:check": "node scripts/check-extension.mjs",
    "store:shots": "node scripts/make-store-screenshots.mjs",
    "icons": "node scripts/make-icons.mjs && tauri icon assets/icon.png",
    "postinstall": "node scripts/fetch-ffmpeg.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-autostart": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "@tauri-apps/plugin-os": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.3.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.2.5",
    "@tsconfig/svelte": "^5.0.4",
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
